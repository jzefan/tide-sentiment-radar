{
  "name": "tide-sentiment-radar",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts src/lib/*.test.ts",
    "check": "tsc -b --pretty false",
    "sentiment:check": "tsx scripts/check-sentiment.ts",
    "xueqiu:session": "tsx scripts/read-xueqiu-session.ts",
    "xueqiu:verify": "tsx scripts/verify-xueqiu-cookie.ts",
    "xueqiu:sync": "tsx scripts/sync-xueqiu.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vitejs/plugin-react": "6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.31.0",
    "pinyin-pro": "^3.29.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.5",
    "playwright-core": "^1.62.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
