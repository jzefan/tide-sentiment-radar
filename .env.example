API_PORT=8788

# 可选：讨论层刷新周期（毫秒），默认 300000（5 分钟），最低 60000（1 分钟）
# 行情仍按实时周期更新，讨论（股吧帖子/评论/雪球）按此周期驱动全市场热度排序
TIDE_DISCUSSION_REFRESH_MS=300000

# 可选：用户自行提供的合法雪球网页会话；未配置时雪球讨论保持关闭。
# 推荐用 pnpm xueqiu:session 从已登录的浏览器一键导入（见 README），
# 手动粘贴的 Cookie 也可填在这里（服务端会通过真浏览器校验后才启用）。
XUEQIU_COOKIE=

# 可选：已取得书面许可的论坛数据接口
FORUM_FEED_URL=
FORUM_FEED_TOKEN=

# 前视冻结所需的涨跌停规则台账（JSON：code -> limitPercent/effectiveFrom/source/sourceVersion/sourceUrl）。
# 未覆盖的沪深股票会使正式冻结 fail-closed；示例：{"600001":{"limitPercent":10,"effectiveFrom":"2020-01-01","source":"exchange-rulebook","sourceVersion":"2026.1","sourceUrl":"https://example.com/rules"}}
TIDE_LIMIT_PERCENT_BY_CODE=
